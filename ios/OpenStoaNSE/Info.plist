<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenStoaNSE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- Both keys MIRROR THE HOST'S ProofportApp/Info.plist exactly. The App Store
	     rejects a bundle whose extension version differs from its host app
	     (ITMS-90473), and the two bump paths reach the two keys differently:
	       - MARKETING_VERSION: scripts/sync-version.js rewrites it in every
	         pbxproj configuration, and the extension target has the setting, so
	         `$(MARKETING_VERSION)` stays in step.
	       - CFBundleVersion: the host carries a LITERAL, bumped by fastlane's
	         increment_build_number via `agvtool new-version -all`, which rewrites
	         every Info.plist in the project — hence a literal here too.
	     `ios/scripts/add_nse_target.rb` re-syncs the literal from the host on
	     every run, so a hand-edited host version cannot leave this one behind. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<!-- App Transport Security is per BUNDLE, and this extension is its own
	     bundle: the host's exceptions in ProofportApp/Info.plist do not reach it.
	     Since P-1 the extension makes a real network request (fetching an
	     encrypted attachment so the notification can show the picture), so it
	     needs its own policy.

	     Only NSAllowsLocalNetworking, deliberately — NOT the host's
	     NSAllowsArbitraryLoads. Production is HTTPS and needs no exception at
	     all; the one case that breaks without this is a developer pointing the
	     mini-app at `http://<LAN IP>:3200`, where the extension would refuse the
	     fetch and every attachment would silently show a caption with no
	     thumbnail — a confusing "it works on the web but not on the phone". This
	     key permits local/private-network HTTP and nothing else, so no insecure
	     load to the public internet becomes possible. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.usernotifications.service</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).NotificationService</string>
	</dict>
	<key>RCTNewArchEnabled</key>
	<true/>
</dict>
</plist>
