default_platform(:ios)

platform :ios do
  desc "Build IPA for local install or TestFlight"
  lane :beta do |options|
    env = options[:env] || "production"
    app_env = env

    setup_ci if ENV['CI']

    if ENV['ASC_API_KEY_PATH'] && File.exist?(ENV['ASC_API_KEY_PATH'])
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_filepath: ENV['ASC_API_KEY_PATH'],
      )
    elsif ENV['ASC_KEY_ID']
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_content: ENV['ASC_API_KEY'],
        is_key_content_base64: true,
      )
    end

    if ENV['CI'] && api_key
      # The OpenStoaNSE notification-service extension is embedded in the host
      # app, so distribution signing needs BOTH profiles — an unsigned .appex
      # fails ValidateEmbeddedBinary at export.
      match(
        type: "appstore",
        app_identifier: ["com.masselabs.zkproofport", "com.masselabs.zkproofport.OpenStoaNSE"],
        readonly: true,
      )

      # `targets:` is required now that the project has two targets: without it
      # update_code_signing_settings writes the host bundle id onto the
      # extension as well.
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ProofportApp.xcodeproj",
        team_id: "R4G32CVY29",
        targets: ["ProofportApp"],
        bundle_identifier: "com.masselabs.zkproofport",
        profile_name: "match AppStore com.masselabs.zkproofport",
        code_sign_identity: "iPhone Distribution",
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ProofportApp.xcodeproj",
        team_id: "R4G32CVY29",
        targets: ["OpenStoaNSE"],
        bundle_identifier: "com.masselabs.zkproofport.OpenStoaNSE",
        profile_name: "match AppStore com.masselabs.zkproofport.OpenStoaNSE",
        code_sign_identity: "iPhone Distribution",
      )
    end

    if api_key
      increment_build_number(
        build_number: ENV['BUILD_NUMBER'] || latest_testflight_build_number(api_key: api_key) + 1,
        xcodeproj: "ProofportApp.xcodeproj",
      )
    end

    build_app(
      workspace: "ProofportApp.xcworkspace",
      scheme: "ProofportApp",
      export_method: ENV['ASC_KEY_ID'] ? "app-store" : "development",
      output_directory: "./build",
      output_name: "ProofportApp.ipa",
      clean: true,
      xcargs: "APP_ENV=#{app_env}",
      export_xcargs: "-allowProvisioningUpdates",
    )

    if api_key
      # altool needs PKCS8 format key, but Ruby OpenSSL 3.x needs EC PEM.
      # Use the original PKCS8 key content for upload if available.
      upload_key = api_key
      if ENV['ASC_API_KEY_PKCS8_PATH'] && File.exist?(ENV['ASC_API_KEY_PKCS8_PATH'])
        upload_key = api_key.dup
        upload_key[:key] = File.read(ENV['ASC_API_KEY_PKCS8_PATH'])
      end
      upload_to_testflight(
        api_key: upload_key,
        skip_waiting_for_build_processing: true,
      )
    end
  end

  desc "Build and submit to App Store"
  lane :release do
    setup_ci if ENV['CI']

    if ENV['ASC_API_KEY_PATH'] && File.exist?(ENV['ASC_API_KEY_PATH'])
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_filepath: ENV['ASC_API_KEY_PATH'],
      )
    else
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_content: ENV['ASC_API_KEY'],
        is_key_content_base64: true,
      )
    end

    # Both ids: the embedded OpenStoaNSE .appex needs its own distribution
    # profile or ValidateEmbeddedBinary rejects the export.
    match(
      type: "appstore",
      app_identifier: ["com.masselabs.zkproofport", "com.masselabs.zkproofport.OpenStoaNSE"],
      readonly: ENV['CI'] == 'true',
    )

    build_app(
      workspace: "ProofportApp.xcworkspace",
      scheme: "ProofportApp",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "ProofportApp.ipa",
      clean: true,
      xcargs: "APP_ENV=production",
      export_xcargs: "-allowProvisioningUpdates",
    )

    # altool needs PKCS8 format key, but Ruby OpenSSL 3.x needs EC PEM.
    upload_key = api_key
    if ENV['ASC_API_KEY_PKCS8_PATH'] && File.exist?(ENV['ASC_API_KEY_PKCS8_PATH'])
      upload_key = api_key.dup
      upload_key[:key] = File.read(ENV['ASC_API_KEY_PKCS8_PATH'])
    end
    upload_to_app_store(
      api_key: upload_key,
      submit_for_review: false,
      force: true,
    )
  end

  desc "READ-ONLY backup of App Store Connect + Developer Portal registrations"
  lane :backup_appstore do |options|
    # Captures everything that has to be re-typed by hand when the app record is
    # recreated on the corporate team (docs/migration/mobile-apps.md §A). This
    # lane NEVER writes to Apple: scripts/asc_backup.rb prepends a guard onto
    # Spaceship's HTTP client that raises on POST/PATCH/DELETE, and the only
    # deliver subcommands it shells out to are download_metadata /
    # download_screenshots, run from a scratch cwd so the repo's Deliverfile
    # (force true / overwrite_screenshots true) is never loaded.
    #
    # Deliberately absent: match (would issue certificates), build_app,
    # upload_to_testflight, upload_to_app_store, deliver run.

    if ENV['ASC_API_KEY_PATH'] && File.exist?(ENV['ASC_API_KEY_PATH'])
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_filepath: ENV['ASC_API_KEY_PATH'],
      )
    elsif ENV['ASC_KEY_ID']
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_content: ENV['ASC_API_KEY'],
        is_key_content_base64: true,
      )
    end

    UI.user_error!("ASC_KEY_ID / ASC_ISSUER_ID and ASC_API_KEY_PATH or ASC_API_KEY are required") unless api_key

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    script = ["../scripts/asc_backup.rb", "scripts/asc_backup.rb"]
             .map { |rel| File.expand_path(rel, FastlaneCore::FastlaneFolder.path || ".") }
             .find { |path| File.exist?(path) }
    UI.user_error!("Could not locate scripts/asc_backup.rb") unless script
    require script

    output_dir = options[:output] || ENV['ASC_BACKUP_OUTPUT']
    output_dir ||= File.expand_path("./build/asc-backup/#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}")

    result = AscBackup.run!(
      output_dir: output_dir,
      app_identifier: options[:app_identifier] || "com.masselabs.zkproofport",
    )

    UI.success("App Store Connect backup written to #{result}")
    UI.important("Read #{File.join(result, 'SUMMARY.md')} before deleting anything.")
    result
  end

  desc "Build IPA only (no upload)"
  lane :build_ipa do |options|
    env = options[:env] || "production"
    app_env = env

    build_app(
      workspace: "ProofportApp.xcworkspace",
      scheme: "ProofportApp",
      export_method: "development",
      output_directory: "./build",
      output_name: "ProofportApp.ipa",
      clean: true,
      xcargs: "APP_ENV=#{app_env}",
      export_xcargs: "-allowProvisioningUpdates",
    )
  end
end
