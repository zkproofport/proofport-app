default_platform(:ios)

# A credential that is set to nothing is not set.
#
# GitHub Actions writes an EMPTY STRING for `${{ secrets.MISSING }}`, and in
# Ruby an empty string is truthy — so `if ENV['SOME_KEY']` is true even when the
# secret does not exist. That matters twice here: it decides whether to build an
# API key at all, and it decides whether the archive is exported for the App
# Store or for development. Getting the second one wrong from a blank value
# produces an export that cannot be uploaded, and the reason is nowhere near the
# failure.
def credential(name)
  value = ENV[name].to_s.strip
  value.empty? ? nil : value
end

platform :ios do
  desc "Build IPA for local install or TestFlight"
  lane :beta do |options|
    env = options[:env] || "production"
    app_env = env

    setup_ci if ENV['CI']

    if credential('ASC_API_KEY_PATH') && File.exist?(ENV['ASC_API_KEY_PATH'])
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_filepath: ENV['ASC_API_KEY_PATH'],
      )
    elsif credential('ASC_KEY_ID')
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_content: ENV['ASC_API_KEY'],
        is_key_content_base64: true,
      )
    end

    # Local `ipa` builds need signing configured too. This used to run only
    # under CI, so a local build reached `archive` with no
    # PROVISIONING_PROFILE_SPECIFIER at all and left Xcode to guess from the
    # bundle id. It guessed right for the host and wrong for the extension —
    # match's profiles are named "match Development <id>", which its matching
    # rules do not find — so every local build died on the .appex with
    # "No profiles for 'com.masselabs.zkproofport.OpenStoaNSE' were found".
    #
    # Distribution profiles are for CI (TestFlight/App Store); a local install
    # onto a registered device is signed with the Development pair.
    local_signing = !ENV['CI'] && api_key
    if local_signing
      match(
        type: "development",
        app_identifier: ["com.masselabs.zkproofport", "com.masselabs.zkproofport.OpenStoaNSE"],
        readonly: true,
      )
      [
        ["ProofportApp", "com.masselabs.zkproofport"],
        ["OpenStoaNSE",  "com.masselabs.zkproofport.OpenStoaNSE"],
      ].each do |target, bundle_id|
        update_code_signing_settings(
          use_automatic_signing: false,
          path: "ProofportApp.xcodeproj",
          team_id: "R4G32CVY29",
          targets: [target],
          bundle_identifier: bundle_id,
          profile_name: "match Development #{bundle_id}",
          code_sign_identity: "Apple Development",
        )
      end
    end

    if ENV['CI'] && api_key
      # The OpenStoaNSE notification-service extension is embedded in the host
      # app, so distribution signing needs BOTH profiles — an unsigned .appex
      # fails ValidateEmbeddedBinary at export.
      match(
        type: "appstore",
        app_identifier: ["com.masselabs.zkproofport", "com.masselabs.zkproofport.OpenStoaNSE"],
        readonly: true,
      )

      # `targets:` is required now that the project has two targets: without it
      # update_code_signing_settings writes the host bundle id onto the
      # extension as well.
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ProofportApp.xcodeproj",
        team_id: "R4G32CVY29",
        targets: ["ProofportApp"],
        bundle_identifier: "com.masselabs.zkproofport",
        profile_name: "match AppStore com.masselabs.zkproofport",
        code_sign_identity: "iPhone Distribution",
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ProofportApp.xcodeproj",
        team_id: "R4G32CVY29",
        targets: ["OpenStoaNSE"],
        bundle_identifier: "com.masselabs.zkproofport.OpenStoaNSE",
        profile_name: "match AppStore com.masselabs.zkproofport.OpenStoaNSE",
        code_sign_identity: "iPhone Distribution",
      )
    end

    if api_key
      increment_build_number(
        build_number: ENV['BUILD_NUMBER'] || latest_testflight_build_number(api_key: api_key) + 1,
        xcodeproj: "ProofportApp.xcodeproj",
      )
    end

    # OPENSTOA_ENABLED is spelled out here rather than left to the Xcode build
    # configuration. The configuration does set it (Debug true, Release false)
    # and archives use Release, so the value would come out right anyway — but
    # it would come out right invisibly. Reading this file would not tell you
    # whether the mini-app ships, and flipping the Release setting in Xcode
    # would change what goes to the App Store with nothing in CI to notice.
    # When OpenStoa is ready to ship, change it here.
    build_app(
      workspace: "ProofportApp.xcworkspace",
      scheme: "ProofportApp",
      export_method: credential('ASC_KEY_ID') ? "app-store" : "development",
      output_directory: "./build",
      output_name: "ProofportApp.ipa",
      clean: true,
      xcargs: "APP_ENV=#{app_env} OPENSTOA_ENABLED=false",
      export_xcargs: "-allowProvisioningUpdates",
    )

    if api_key
      # altool needs PKCS8 format key, but Ruby OpenSSL 3.x needs EC PEM.
      # Use the original PKCS8 key content for upload if available.
      upload_key = api_key
      if ENV['ASC_API_KEY_PKCS8_PATH'] && File.exist?(ENV['ASC_API_KEY_PKCS8_PATH'])
        upload_key = api_key.dup
        upload_key[:key] = File.read(ENV['ASC_API_KEY_PKCS8_PATH'])
      end
      # ASKING APPLE FOR REVIEW IS THE CALLER'S CHOICE, AND IT IS OFF BY DEFAULT.
      #
      # Uploading to TestFlight and submitting to the App Store are two separate
      # acts, and only the first one is reversible. This lane always does the
      # first; it does the second only when told to.
      submit = options[:submit_for_review].to_s == "true"

      # Submitting names a build, so the build has to have finished processing
      # first. Waiting costs several minutes and buys nothing when all we want
      # is TestFlight, which is why it is skipped in that case.
      upload_to_testflight(
        api_key: upload_key,
        skip_waiting_for_build_processing: !submit,
      )

      if submit
        # No second archive: the binary is already uploaded, so this call only
        # writes the App Store version record and asks for review.
        #
        # WHAT THIS NEEDS THAT TESTFLIGHT DOES NOT. Checked against App Store
        # Connect on 2026-09-04: the only version record on the app is 1.0.0 in
        # PREPARE_FOR_SUBMISSION, while TestFlight holds 1.0.1. `force: true`
        # skips deliver's confirmation page; the version record itself is
        # created from `app_version`. A version after the first also needs
        # release notes — fastlane/metadata/<locale>/release_notes.txt — or
        # Apple rejects the submission for empty "What's New".
        upload_to_app_store(
          api_key: upload_key,
          app_version: get_version_number(xcodeproj: "ProofportApp.xcodeproj", target: "ProofportApp"),
          skip_binary_upload: true,
          skip_screenshots: true,
          submit_for_review: true,
          force: true,
          precheck_include_in_app_purchases: false,
          submission_information: { add_id_info_uses_idfa: false },
        )
      end
    else
      # NO CREDENTIAL, SO NO UPLOAD — say so, loudly.
      #
      # Same shape as the Play upload in android/fastlane/Fastfile, and the same
      # trap: with no key the lane runs off the end, the IPA is built and signed,
      # and nothing reaches TestFlight. The build goes green either way, so
      # "the upload failed" and "the upload never happened" look identical.
      #
      # A warning rather than a failure: `beta` is also how a local IPA gets
      # built for a device, and that has no business needing an App Store key.
      UI.important("No App Store Connect key — set ASC_KEY_ID / ASC_ISSUER_ID and either ASC_API_KEY_PATH or ASC_API_KEY.")
      UI.important("The IPA was built and signed at ./build/ProofportApp.ipa, and NOT uploaded to TestFlight.")
    end
  end

  desc "Build and submit to App Store"
  lane :release do
    setup_ci if ENV['CI']

    if credential('ASC_API_KEY_PATH') && File.exist?(ENV['ASC_API_KEY_PATH'])
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_filepath: ENV['ASC_API_KEY_PATH'],
      )
    else
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_content: ENV['ASC_API_KEY'],
        is_key_content_base64: true,
      )
    end

    # Both ids: the embedded OpenStoaNSE .appex needs its own distribution
    # profile or ValidateEmbeddedBinary rejects the export.
    match(
      type: "appstore",
      app_identifier: ["com.masselabs.zkproofport", "com.masselabs.zkproofport.OpenStoaNSE"],
      readonly: ENV['CI'] == 'true',
    )

    build_app(
      workspace: "ProofportApp.xcworkspace",
      scheme: "ProofportApp",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "ProofportApp.ipa",
      clean: true,
      xcargs: "APP_ENV=production OPENSTOA_ENABLED=false",
      export_xcargs: "-allowProvisioningUpdates",
    )

    # altool needs PKCS8 format key, but Ruby OpenSSL 3.x needs EC PEM.
    upload_key = api_key
    if ENV['ASC_API_KEY_PKCS8_PATH'] && File.exist?(ENV['ASC_API_KEY_PKCS8_PATH'])
      upload_key = api_key.dup
      upload_key[:key] = File.read(ENV['ASC_API_KEY_PKCS8_PATH'])
    end
    upload_to_app_store(
      api_key: upload_key,
      submit_for_review: false,
      force: true,
    )
  end

  desc "READ-ONLY backup of App Store Connect + Developer Portal registrations"
  lane :backup_appstore do |options|
    # Captures everything that has to be re-typed by hand when the app record is
    # recreated on the corporate team (docs/migration/mobile-apps.md §A). This
    # lane NEVER writes to Apple: scripts/asc_backup.rb prepends a guard onto
    # Spaceship's HTTP client that raises on POST/PATCH/DELETE, and the only
    # deliver subcommands it shells out to are download_metadata /
    # download_screenshots, run from a scratch cwd so the repo's Deliverfile
    # (force true / overwrite_screenshots true) is never loaded.
    #
    # Deliberately absent: match (would issue certificates), build_app,
    # upload_to_testflight, upload_to_app_store, deliver run.

    if credential('ASC_API_KEY_PATH') && File.exist?(ENV['ASC_API_KEY_PATH'])
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_filepath: ENV['ASC_API_KEY_PATH'],
      )
    elsif credential('ASC_KEY_ID')
      api_key = app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_content: ENV['ASC_API_KEY'],
        is_key_content_base64: true,
      )
    end

    UI.user_error!("ASC_KEY_ID / ASC_ISSUER_ID and ASC_API_KEY_PATH or ASC_API_KEY are required") unless api_key

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    script = ["../scripts/asc_backup.rb", "scripts/asc_backup.rb"]
             .map { |rel| File.expand_path(rel, FastlaneCore::FastlaneFolder.path || ".") }
             .find { |path| File.exist?(path) }
    UI.user_error!("Could not locate scripts/asc_backup.rb") unless script
    require script

    output_dir = options[:output] || ENV['ASC_BACKUP_OUTPUT']
    output_dir ||= File.expand_path("./build/asc-backup/#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}")

    result = AscBackup.run!(
      output_dir: output_dir,
      app_identifier: options[:app_identifier] || "com.masselabs.zkproofport",
    )

    UI.success("App Store Connect backup written to #{result}")
    UI.important("Read #{File.join(result, 'SUMMARY.md')} before deleting anything.")
    result
  end

  desc "Build IPA only (no upload)"
  lane :build_ipa do |options|
    env = options[:env] || "production"
    app_env = env

    # Signing has to be pinned here, not left to Xcode. The project signs
    # manually (no CODE_SIGN_STYLE = Automatic) and carried no
    # PROVISIONING_PROFILE_SPECIFIER, so Xcode fell back to matching profiles by
    # bundle id. That found the host app and did NOT find the extension —
    # match names its profiles "match Development <id>", which that matching
    # does not recognise — and every local build died with "No profiles for
    # 'com.masselabs.zkproofport.OpenStoaNSE' were found". The profiles were on
    # disk the whole time; nothing pointed at them.
    #
    # It only surfaced with the corporate team because the old personal-team
    # profiles happened to satisfy Xcode's guess.
    #
    # Development, not appstore: this lane builds for a local install onto a
    # registered device. The appstore pair belongs to `beta`.
    if credential('ASC_KEY_ID') || credential('ASC_API_KEY_PATH')
      api_key =
        if credential('ASC_API_KEY_PATH') && File.exist?(ENV['ASC_API_KEY_PATH'])
          app_store_connect_api_key(
            key_id: ENV['ASC_KEY_ID'],
            issuer_id: ENV['ASC_ISSUER_ID'],
            key_filepath: ENV['ASC_API_KEY_PATH'],
          )
        end
      match(
        type: "development",
        app_identifier: ["com.masselabs.zkproofport", "com.masselabs.zkproofport.OpenStoaNSE"],
        readonly: true,
        api_key: api_key,
      )
      [
        ["ProofportApp", "com.masselabs.zkproofport"],
        ["OpenStoaNSE",  "com.masselabs.zkproofport.OpenStoaNSE"],
      ].each do |target, bundle_id|
        update_code_signing_settings(
          use_automatic_signing: false,
          path: "ProofportApp.xcodeproj",
          team_id: "R4G32CVY29",
          targets: [target],
          bundle_identifier: bundle_id,
          profile_name: "match Development #{bundle_id}",
          code_sign_identity: "Apple Development",
        )
      end
    end

    build_app(
      workspace: "ProofportApp.xcworkspace",
      scheme: "ProofportApp",
      export_method: "development",
      output_directory: "./build",
      output_name: "ProofportApp.ipa",
      clean: true,
      xcargs: "APP_ENV=#{app_env}",
      export_xcargs: "-allowProvisioningUpdates",
    )
  end
end
