<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.zkproofport.app</string>
		<!-- E2EE chat Phase 7 (§13.5/§13.6): shared group the OpenStoa NSE also holds
		     so it can READ the E2EE decrypt keys this app stores. Appended (not
		     first) so the app's default keychain group is unchanged. The mini-app's
		     E2EE key writes (expo-secure-store) must target this group for the NSE
		     to read them — device-deferred. Kept in sync with OpenStoaNSE.entitlements
		     and plugins/withOpenStoaNSE.js. -->
		<string>$(AppIdentifierPrefix)com.zkproofport.app.openstoa</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:stg-community.zkproofport.app</string>
	</array>
</dict>
</plist>
