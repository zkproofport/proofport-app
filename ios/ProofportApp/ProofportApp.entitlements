<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.masselabs.zkproofport</string>
		<!-- E2EE chat Phase 7 (§13.5/§13.6): shared group the OpenStoa NSE also holds
		     so it can READ the E2EE decrypt keys this app stores. Appended (not
		     first) so the app's default keychain group is unchanged. The mini-app's
		     E2EE key writes (expo-secure-store) must target this group for the NSE
		     to read them — device-deferred. Kept in sync with OpenStoaNSE.entitlements
		     and plugins/withOpenStoaNSE.js. -->
		<string>$(AppIdentifierPrefix)com.masselabs.zkproofport.openstoa</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<!-- Both origins, because the passkey domain follows the build's
	     environment (see src/openstoa-host/passkeyDomain.ts) and iOS only
	     honours a domain listed here. A production build that asked for
	     www.openstoa.xyz while this named staging alone would fail at the
	     passkey prompt with no useful message. Both serve the association
	     file naming this app's team; checked 2026-08-30. -->
	<array>
		<string>webcredentials:www.openstoa.xyz</string>
		<string>webcredentials:stg-community.zkproofport.app</string>
	</array>
	<!-- E2EE chat Phase 6/7 push (§13): required for iOS to hand out an APNs
	     token. Without it getExpoPushTokenAsync throws, registerForPush returns
	     null, and the device never reaches POST /api/push/register — push is
	     silently dead. `development` is the sandbox APNs environment used by
	     locally signed builds; App Store / TestFlight builds are re-signed to
	     `production` automatically. The APNs key is Team-scoped for Sandbox &
	     Production, so one key serves both. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
