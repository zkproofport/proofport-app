<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- The languages this app has translations for.

	     iOS hands an app a locale from the INTERSECTION of the phone's preferred
	     languages and this list. Without the key the intersection is {en}, so a
	     Korean phone got en-US, `getDeviceLanguage()` answered 'en' from a
	     correct reading, and every Korean user saw an English app while the
	     Korean translations sat complete and unreachable in src/i18n/locales/ko.json.

	     Found 2026-08-30 on a TestFlight build, on an iPhone, months after the
	     same symptom was chased and declared fixed on Android — Android needs no
	     such declaration, so testing there could never have surfaced it.

	     Keep this list equal to the filenames in src/i18n/locales/. Pinned by
	     src/__tests__/iosOffersEveryLanguageWeTranslated.test.ts. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>ZKProofport</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.masselabs.zkproofport</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zkproofport</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.491923400813-ei78mtmkjppvueb577lqai14e4jvbmqk</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>microsoft-auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msal8b09c842-d7a8-4d9c-a6ea-46c797412bac</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>metamask</string>
		<string>trust</string>
		<string>rainbow</string>
		<string>wc</string>
		<string>cbwallet</string>
		<string>zerion</string>
		<string>imtokenv2</string>
		<!-- Korea mDL (모바일 신분증). iOS `canOpenURL` returns false for any
		     scheme not listed here, which is the same class of failure Android
		     hit through <queries>: the app is installed and the flow still
		     reports it missing. -->
		<string>mobileid</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>walletconnect.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>walletconnect.org</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSTemporaryExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>RCTNewArchEnabled</key>
	<true/>
	<!-- APNs BACKGROUND DELIVERY. Maintained BY HAND, on purpose.
	     This is a bare (prebuild-less) project: `ios/` is committed and neither
	     `npm run ios` nor .github/workflows/build-ios.yml ever runs
	     `expo prebuild`, so the `expo-notifications` config plugin declared in
	     app.json — `{ "enableBackgroundRemoteNotifications": true }` — NEVER
	     executes and can never add this key for us. It was silently absent from
	     both the source plist and the shipped .app until 2026-08-21.
	     Without `remote-notification`, iOS refuses to wake the app for
	     `aps.content-available = 1`, which is exactly what the OpenStoa server
	     sets on every chat push (openstoa/src/lib/pushProvider.ts,
	     `_contentAvailable: true`), so the background `key-needed` auto-grant in
	     src/openstoa-host/pushTapBridge.ts never fires.
	     The OpenStoaNSE extension needs NO counterpart: a
	     UNNotificationServiceExtension is woken by `aps.mutable-content = 1`, and
	     UIBackgroundModes is a host-app-only key that Apple ignores in an
	     appex bundle. Both halves are pinned by
	     src/openstoa-host/__tests__/iosPushBackgroundModes.test.ts. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- ZKProofport never asks for location, so this text is never shown. Apple
	     requires it anyway: the notification component links CoreLocation
	     unconditionally to describe location-triggered notifications, and the
	     camera component links it to tag photos. Build 2 was accepted but came
	     back with ITMS-90683 for exactly this. Keep the wording truthful — a
	     reviewer reading this file should not find a reason we do not have. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ZKProofport does not use your location. This appears only because the camera and notification components it is built on include location features, which ZKProofport leaves switched off.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ZKProofport needs local network access to communicate with the proof relay server</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>ZKProofport needs camera access to scan QR codes for proof requests</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ZKProofport needs photo library access to attach images to OpenStoa chat messages</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ZKProofport needs permission to save proofs and screenshots to your photo library</string>
	<key>AppEnv</key>
	<string>$(APP_ENV)</string>
	<!-- Set per build (xcargs / build setting), mirroring APP_ENV. Empty or
	     absent means enabled — see AppEnvModule. -->
	<key>OpenStoaEnabled</key>
	<string>$(OPENSTOA_ENABLED)</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>Feather.ttf</string>
		<string>MaterialCommunityIcons.ttf</string>
	</array>
</dict>
</plist>
