default_platform(:android)

# A credential that is set to nothing is not set.
#
# GitHub Actions writes an EMPTY STRING for `${{ secrets.MISSING }}`, and in
# Ruby an empty string is truthy — so `if ENV['SOME_KEY']` is true even when the
# secret does not exist. A workflow that references a secret nobody has created
# would therefore walk into the upload branch with no credential, and fail deep
# inside the upload tool instead of at the branch that exists to say "there is
# no credential, so nothing was uploaded".
def credential(name)
  value = ENV[name].to_s.strip
  value.empty? ? nil : value
end

platform :android do
  desc "Build release AAB and upload to Play Console alpha track"
  lane :beta do |options|
    flavor = options[:flavor] || "production"
    props = {
      "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_FILE'],
      "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
      "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
      "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD'],
    }
    gradle(
      task: "bundle",
      flavor: flavor,
      build_type: "Release",
      properties: props,
    )

    # One package name for every flavor, matching `applicationId` in
    # app/build.gradle. There is no `applicationIdSuffix` anywhere, so the AAB
    # this lane just built is always `com.masselabs.zkproofport` — naming
    # anything else here only tells Play about a listing that does not exist.
    #
    # This used to read an APP_ID_SUFFIX environment variable and, failing that,
    # append `.staging` for the staging flavor. Neither branch could be right:
    # nothing applied a suffix to the build, and the workflow set the variable
    # the wrong way round — picking production sent `.staging`, picking staging
    # sent nothing.
    pkg = "com.masselabs.zkproofport"

    # Three ways to hand over the Play service account, and they are not
    # interchangeable. `json_key` wants a PATH ON DISK; `json_key_data` wants
    # the JSON ITSELF. fastlane declares them as conflicting options, so exactly
    # one may be passed.
    #
    # A GitHub Actions secret holds the JSON itself, never a path — so the
    # content form is the one CI uses, and it is checked first. Setting the
    # path-shaped variable to the JSON text fails inside the upload tool with a
    # file-not-found, which reads nothing like "you gave it the wrong shape".
    if credential('SUPPLY_JSON_KEY_DATA')
      supply(
        track: "alpha",
        json_key_data: credential('SUPPLY_JSON_KEY_DATA'),
        package_name: pkg,
        aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true,
      )
    elsif credential('GOOGLE_APPLICATION_CREDENTIALS')
      supply(
        track: "alpha",
        json_key: credential('GOOGLE_APPLICATION_CREDENTIALS'),
        package_name: pkg,
        aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true,
      )
    elsif credential('SUPPLY_JSON_KEY')
      supply(
        track: "alpha",
        package_name: pkg,
        aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true,
      )
    else
      # NO CREDENTIAL, SO NO UPLOAD — say so, loudly.
      #
      # This used to be an `if/elsif` with no `else`: with neither variable set,
      # the lane simply ran off the end. The build went green, the AAB was built
      # and signed, and nothing reached Play. Nothing in the log said why, so
      # "the upload is broken" and "the upload never ran" looked identical from
      # the outside.
      #
      # Deliberately a warning and not a failure: building the AAB without
      # publishing it is a real thing to want (a local release build, a CI job
      # that only checks the build compiles). What must not happen is doing it
      # by accident and believing otherwise.
      UI.important("No Play credential — set SUPPLY_JSON_KEY_DATA (the service-account JSON itself, what a CI secret holds), or GOOGLE_APPLICATION_CREDENTIALS / SUPPLY_JSON_KEY (a path to that JSON on disk).")
      UI.important("The AAB was built and signed at #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}, and NOT uploaded to Play.")
    end
  end

  desc "Upload the store listing only — no build, no release"
  lane :store_listing do
    # The `beta` lane above skips metadata ON PURPOSE: shipping a build must
    # not silently rewrite the store page. But that left the listing with no
    # way up at all — the text sat in android/fastlane/metadata/ and nothing
    # ever read it, the same shape of gap as the release workflow that had no
    # path to Play. So the listing gets its own deliberate act.
    #
    # Images and screenshots stay skipped because none exist yet: the shots in
    # the repo are iPhone-sized (1320x2868) and Play would reject them. When
    # Android shots are taken, flip skip_upload_images / skip_upload_screenshots
    # here in the same change that adds them.
    #
    # `track` is required by the upload tool but means nothing here — with both
    # skip_upload_aab and skip_upload_apk set, no release is created on any
    # track. "internal" is named rather than "production" so a misreading of
    # this lane cannot be mistaken for a production release.
    common = {
      package_name: "com.masselabs.zkproofport",
      track: "internal",
      metadata_path: "./fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    }

    # Same three credential shapes, same order, same reasons as `beta`.
    if credential('SUPPLY_JSON_KEY_DATA')
      supply(**common, json_key_data: credential('SUPPLY_JSON_KEY_DATA'))
    elsif credential('GOOGLE_APPLICATION_CREDENTIALS')
      supply(**common, json_key: credential('GOOGLE_APPLICATION_CREDENTIALS'))
    elsif credential('SUPPLY_JSON_KEY')
      supply(**common)
    else
      UI.user_error!("No Play credential — set SUPPLY_JSON_KEY_DATA (the service-account JSON itself), or GOOGLE_APPLICATION_CREDENTIALS / SUPPLY_JSON_KEY (a path to it on disk). Nothing was uploaded.")
    end
  end

  desc "Build release APK"
  lane :build_apk do |options|
    flavor = options[:flavor] || "production"
    gradle(
      task: "assemble",
      flavor: flavor,
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_FILE'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD'],
      },
    )
  end
end
